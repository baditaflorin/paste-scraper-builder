{
  "name": "paste-scraper-builder",
  "private": true,
  "version": "0.3.0",
  "releaseDate": "2026-05-09T00:00:00.000Z",
  "description": "Build scrapers by pasting rendered HTML, picking selectors visually, and exporting CSV or code.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/write-build-meta.mjs",
    "build": "tsc -b && vite build",
    "pages-preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke.sh",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "install-hooks": "git config core.hooksPath .githooks",
    "hooks-pre-commit": "bash .githooks/pre-commit",
    "hooks-commit-msg": "bash .githooks/commit-msg .git/COMMIT_EDITMSG",
    "hooks-pre-push": "bash .githooks/pre-push",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.9",
    "idb": "^8.0.3",
    "lucide-react": "^1.14.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
